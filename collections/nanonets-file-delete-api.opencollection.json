{
  "opencollection": "1.0.0",
  "info": {
    "name": "Nanonets External Integrations File Delete API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "File Delete",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Delete A File",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.nanonets.com/api/v2/Inferences/Model/:model_id/InferenceRequestFiles/:file_id",
            "params": [
              {
                "name": "model_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "file_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Permanently delete a processed file from a model."
        }
      ]
    }
  ],
  "bundled": true
}